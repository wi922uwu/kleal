# the app codebase lives in its own git repo (with its own secrets/.env)
/dating/

# python
__pycache__/
*.pyc

# buddy local sqlite (created at runtime)
buddy.db
buddy_local.db

# secrets / env
.env
*.env
*.env.local

# node
node_modules/
package-lock.json
# ...кроме мобильного приложения: локфайл — это воспроизводимая установка, без него
# `npm ci` невозможен и сборка на другой машине приедет с другими версиями.
!kleal-app/package-lock.json

# build/ holds lots of scratch (base64 deploy scripts, figma screenshots, dumps, backups).
# Ignore all of it EXCEPT the reusable deploy generators.
build/*
!build/deploy_to_pod.py
!build/deploy_v2_to_pod.py
!build/deploy_bundle_to_pod.py

# extracted content dumps + misc scratch
*.png
# ...кроме иконок приложения: без них не собирается ни один нативный билд.
!kleal-app/assets/*.png
# ...и кроме экспортированной из Figma графики входных экранов. Она попала под общий запрет
# «*.png» и оказалась вне версии: логотип, рука на welcome, значки Apple и Google и замочная
# скважина жили только на ноутбуке и на сервере. По правилу проекта (AGENTS.md, «источник правды —
# git») это значит «потеряны»: следующая же чистая проверка ветки собиралась бы без них.
!kleal-app/assets/art/*.png
docx_content.txt
ods_content.txt
xlsx_content.txt
index_remote.html
ALIA-40b-deploy-log.md
alia_dl_sup.sh
extract_docs.py
llm_demo_app.py

# credentials — never in git, even hashed
accounts.json
accounts.json.tmp

# admin token — generated per box, never in git
admin_token.txt

# graphify knowledge-graph output (generated; rebuild with /graphify)
graphify-out/

# runtime state written next to the services
kleal-ms/users.json
kleal-ms/users.json.tmp
kleal-ms/services/*/buddy_store.json
kleal-ms/services/*/kleal_store.json
kleal-ms/services/*/learned_topics.json
kleal-ms/ops/logs/

# expo / react-native
kleal-app/node_modules/
kleal-app/.expo/
kleal-app/dist/
kleal-app/ios/
kleal-app/android/
*.tsbuildinfo
