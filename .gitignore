# the app codebase lives in its own git repo (with its own secrets/.env)
dating/

# python
__pycache__/
*.pyc

# secrets / env
.env
*.env
*.env.local

# node
node_modules/
package-lock.json
!kleal-app/package-lock.json
kleal-app/dist-*/

# Expo application assets are source files.
!kleal-app/assets/
!kleal-app/assets/*.png

# Production runtime data.
kleal-ms/users.json*
kleal-ms/accounts.json
kleal-ms/waitlist.json
