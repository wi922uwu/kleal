*.prev_*
._*

# build/ holds lots of scratch (base64 deploy scripts, figma screenshots, dumps, backups).
# Ignore all of it EXCEPT the reusable deploy generators.
build/*
!build/deploy_to_pod.py
!build/deploy_v2_to_pod.py
!build/deploy_bundle_to_pod.py

