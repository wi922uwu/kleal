# the app codebase lives in its own git repo (with its own secrets/.env)
dating/

# python
__pycache__/
*.pyc

# secrets / env
.env
*.env
*.env.local

# per-dev knowledge-graph memory data (config .mcp.json IS shared; the graph data is local)
.claude/memory.json

# node
node_modules/
package-lock.json

# build/ holds lots of scratch (base64 deploy scripts, figma screenshots, dumps, backups).
# Ignore all of it EXCEPT the reusable deploy generators.
build/*
!build/deploy_to_pod.py
!build/deploy_v2_to_pod.py
!build/deploy_bundle_to_pod.py
!build/deploy_microservices.py

# microservices runtime state (server-side session store) + logs
services/matching/kleal_store.json
kleal_store.json
*.log

# extracted content dumps + misc scratch
*.png
docx_content.txt
ods_content.txt
