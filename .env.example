# Kleal — secrets & model config. Copy to `.env` (gitignored). These are consumed ONLY by llm-service;
# run_all.py scrubs them from every other service's environment. NEVER commit real keys.

# Self-hosted vLLM (the default `llama_self` model / prod path). For local dev point this at the
# pod's :8002 cloudflared tunnel; on the pod itself it is http://localhost:8002/v1.
SELF_BASE=http://localhost:8002/v1
SELF_KEY=x

# aitunnel (the 6 external comparison models). Leave blank if you only use llama_self.
AITUNNEL_KEY=
AITUNNEL_BASE=https://api.aitunnel.ru/v1

# Which model id the onboarding + matching agents use (a MODELS key from services/llm/app.py).
V2_MODEL=llama_self

# Admin panel (test-mode user CRUD at <gateway>/admin). Set a STRONG token — it can delete users
# and sits behind the public gateway. Consumed only by admin-service.
ADMIN_TOKEN=changeme-admin
