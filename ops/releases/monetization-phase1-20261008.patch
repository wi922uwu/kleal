index 0000000..841c691
--- /dev/null
+++ b/kleal-ms/shared/monetization.py
@@ -0,0 +1,106 @@
+"""Phase 1: server-owned, opt-in Preview. No payment processing or product gates.
+
+Never infer paid access from a client field, a redirect, or an unverified receipt.
+Store billing and product quota enforcement will be added after product approval.
+"""
+import os
+import sqlite3
+import time
+from pathlib import Path
+
+PREVIEW_SECONDS = 14 * 24 * 60 * 60
+PRODUCTS = (
+    {"id": "plus_monthly", "period": "month", "referencePriceCents": 1199, "currency": "EUR"},
+    {"id": "plus_annual", "period": "year", "referencePriceCents": 8999, "currency": "EUR"},
+)
+
+
+class MonetizationError(Exception):
+    def __init__(self, code, status=400):
+        super().__init__(code)
+        self.code, self.status = code, status
+
+
+def preview_enabled():
+    return os.environ.get("KLEAL_MONETIZATION_PREVIEW_ENABLED") == "1"
+
+
+def database_path():
+    value = os.environ.get("KLEAL_MONETIZATION_DB", "")
+    if not value or not Path(value).is_absolute():
+        raise MonetizationError("monetization_not_configured", 503)
+    return value
+
+
+class PreviewStore:
+    def __init__(self, path, clock=time.time):
+        self.path, self.clock = str(path), clock
+
+    def connect(self):
+        # Parent directory is provisioned explicitly; never create a shared directory silently.
+        conn = sqlite3.connect(self.path, timeout=10, isolation_level=None)
+        conn.row_factory = sqlite3.Row
+        conn.execute("CREATE TABLE IF NOT EXISTS monetization_preview ("
+                     "person_id TEXT PRIMARY KEY, started_at INTEGER NOT NULL, "
+                     "expires_at INTEGER NOT NULL)")
+        return conn
+
+    def read(self, person_id):
+        conn = self.connect()
+        try:
+            row = conn.execute("SELECT started_at, expires_at FROM monetization_preview "
+                               "WHERE person_id = ?", (person_id,)).fetchone()
+            return dict(row) if row else None
+        finally:
+            conn.close()
+
+    def start(self, person_id):
+        if not isinstance(person_id, str) or not person_id.strip():
+            raise MonetizationError("sign_in_required", 401)
+        now = int(self.clock())
+        conn = self.connect()
+        try:
+            conn.execute("BEGIN IMMEDIATE")
+            # Unique owner + transaction: retries, reinstalls and simultaneous devices never extend it.
+            conn.execute("INSERT OR IGNORE INTO monetization_preview VALUES (?, ?, ?)",
+                         (person_id, now, now + PREVIEW_SECONDS))
+            row = conn.execute("SELECT started_at, expires_at FROM monetization_preview "
+                               "WHERE person_id = ?", (person_id,)).fetchone()
+            conn.commit()
+            return dict(row)
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+
+def describe(row=None, *, enabled=False, now=None):
+    now = int(time.time() if now is None else now)
+    active = bool(enabled and row and row["expires_at"] > now)
+    state = "preview" if active else ("expired" if row else "free")
+    return {
+        "ok": True, "state": state, "plan": "plus" if active else "free",
+        "source": "preview" if row else "none", "serverTime": now,
+        "previewStartedAt": row["started_at"] if row else None,
+        "expiresAt": row["expires_at"] if row else None,
+        "canStartPreview": bool(enabled and not row), "previewEnabled": enabled,
+        "previewDays": 14, "purchaseAvailable": False, "restoreAvailable": False,
+        "enforcementEnabled": False, "phase": "foundation",
+        # Reference prices are NOT live store prices or an offer to charge the customer.
+        "products": [dict(p) for p in PRODUCTS],
+    }
+
+
+def status(person_id):
+    if not preview_enabled():
+        return describe()
+    store = PreviewStore(database_path())
+    return describe(store.read(person_id), enabled=True)
+
+
+def start_preview(person_id):
+    if not preview_enabled():
+        raise MonetizationError("preview_unavailable", 409)
+    store = PreviewStore(database_path())
+    return describe(store.start(person_id), enabled=True)
diff --git a/kleal-ms/shared/monetization_http.py b/kleal-ms/shared/monetization_http.py
new file mode 100644
index 0000000..a34be07
--- /dev/null
+++ b/kleal-ms/shared/monetization_http.py
@@ -0,0 +1,70 @@
+"""Authenticated adapter on the existing onboarding prefix; no new gateway route."""
+import json
+import sqlite3
+from urllib.parse import urlsplit
+import kleal_auth
+import monetization as billing
+
+PREFIX = "/api/onboarding/monetization"
+
+
+def respond(handler, status, data):
+    raw = json.dumps(data, ensure_ascii=False).encode("utf-8")
+    handler.send_response(status)
+    handler.send_header("Content-Type", "application/json; charset=utf-8")
+    handler.send_header("Cache-Control", "no-store")
+    handler.send_header("X-Content-Type-Options", "nosniff")
+    handler.send_header("Content-Length", str(len(raw)))
+    handler.end_headers()
+    handler.wfile.write(raw)
+
+
+def handle(handler):
+    path = urlsplit(handler.path).path
+    if path != PREFIX and not path.startswith(PREFIX + "/"):
+        return False
+    # Failed auth/invalid bodies must not leave unread bytes on a reusable connection.
+    handler.close_connection = True
+    try:
+        method = handler.command
+        if (method, path) not in {
+            ("GET", PREFIX + "/status"), ("POST", PREFIX + "/preview"),
+            ("POST", PREFIX + "/purchase"), ("POST", PREFIX + "/restore"),
+        }:
+            raise billing.MonetizationError("not_found", 404)
+        person = kleal_auth.caller_person(handler, strict_storage=True)
+        person_id = str((person or {}).get("id") or "")
+        if not person_id:
+            raise billing.MonetizationError("sign_in_required", 401)
+        if method == "POST":
+            if handler.headers.get("Transfer-Encoding"):
+                raise billing.MonetizationError("invalid_request")
+            try:
+                length = int(handler.headers.get("Content-Length", "0"))
+            except ValueError:
+                raise billing.MonetizationError("invalid_request") from None
+            if not 0 < length <= 256:
+                raise billing.MonetizationError("invalid_request")
+            raw = handler.rfile.read(length)
+            if len(raw) != length:
+                raise billing.MonetizationError("invalid_request")
+            body = json.loads(raw)
+            if path.endswith("/preview"):
+                # No client-supplied user, duration, status or price is accepted.
+                if not isinstance(body, dict) or set(body) != {"consent"} or body["consent"] is not True:
+                    raise billing.MonetizationError("invalid_request")
+                result = billing.start_preview(person_id)
+            else:
+                if body != {}:
+                    raise billing.MonetizationError("invalid_request")
+                raise billing.MonetizationError("store_not_configured", 409)
+        else:
+            result = billing.status(person_id)
+        respond(handler, 200, result)
+    except billing.MonetizationError as error:
+        respond(handler, error.status, {"ok": False, "error": error.code})
+    except (ValueError, UnicodeError):
+        respond(handler, 400, {"ok": False, "error": "invalid_request"})
+    except (sqlite3.Error, OSError, kleal_auth.IdentityStorageUnavailable):
+        respond(handler, 503, {"ok": False, "error": "monetization_unavailable"})
+    return True
